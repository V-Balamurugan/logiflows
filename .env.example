# ==============================================================================
# LogiFlows B2B Service Platform - Environment Configuration Template
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=dev_secret_key_change_in_production_logiflows_2026_secure
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB=logiflows_db
POSTGRES_USER=logiflows_user
POSTGRES_PASSWORD=logiflows_dev_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
PORT=3000

# Email Delivery Configuration (Mailpit in local development)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=LogiFlows <noreply@logiflows.com>
FRONTEND_URL=http://localhost:5174

# Cookie & Authentication Settings
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth/
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
